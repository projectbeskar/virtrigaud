# Reference unit that starts the per-host agent once per boot. Development
# builds only: no release artefact ships the agent or this unit.
#
# On a host where the agent arrives as a system extension merged during the
# boot, the .wants links of the extension's [Install] sections start nothing:
# the boot transaction was computed before the merge. A unit upheld by
# multi-user.target (see multi-user.target.d/virtrigaud-agent.conf) is
# started even so. The agent itself must not be upheld, or an operator could
# not stop it for maintenance: systemd would start it again at once. This
# unit is upheld instead. It is a oneshot that stays active
# (RemainAfterExit=yes) once it has asked systemd to start the agent
# (--no-block: it does not wait for the agent), so Upholds= does not run it
# again in the same boot, and an agent stopped for maintenance stays stopped.
# It has no dependency on the agent's unit: stopping or restarting the agent
# never involves it.
#
# Its action is "vrtg-agent boot-start", which acts at most once per boot:
# it first creates the marker /run/vrtg-agent-boot-start/started
# (exclusively), and does nothing when the marker already exists. The
# runtime directory is kept when the unit stops (RuntimeDirectoryPreserve=)
# and goes with the reboot, so a restart or try-restart of this unit, by
# hand or by a package's upgrade scripts, never starts an agent stopped for
# maintenance; a reboot re-arms it. The marker is made before the start, so
# an interruption can only miss a start (start the agent by hand), never
# start it twice.
#
# It runs after vrtg-agent-setup.service (it wants it and is ordered after
# it), and creates its marker only once the setup unit is active: when setup
# failed, it logs a warning, leaves no marker and starts nothing, so a later
# start of this unit (after the cause is fixed) still acts once. Any start
# of the agent earlier in the boot (by hand, say, after setup was fixed) is
# the boot's decision: it then makes its marker and starts nothing. It does not
# require the setup unit: it is upheld, and Upholds= would start it again,
# without end, while setup failed.
#
# Then it starts the agent only while vrtg-agent.service is enabled
# (systemctl is-enabled: enabled, enabled-runtime, static, ...), so that
# "systemctl disable vrtg-agent.service" keeps the agent off at boot, and
# "systemctl mask" keeps it off entirely. The check is in the action, not an
# ExecCondition=: a skipped unit is inactive, and Upholds= would start it
# again at once, over and over, until its start limit failed it. Here the
# unit succeeds and stays active.
[Unit]
Description=VirtRigaud: start the per-host agent once per boot (development builds only)
Documentation=https://github.com/projectbeskar/virtrigaud/blob/main/docs/per-host-agent-development.md
Wants=vrtg-agent-setup.service
After=vrtg-agent-setup.service
# Bounded restarts: Upholds= starts this unit again whenever it is found
# inactive or failed; its action succeeds whether or not setup did. A unit that keeps failing is started at most 5
# times in 5 minutes, then stays failed ("Start request repeated too
# quickly", result start-limit-hit) until "systemctl reset-failed" or a
# reboot.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/virtrigaud/vrtg-agent boot-start
RuntimeDirectory=vrtg-agent-boot-start
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
