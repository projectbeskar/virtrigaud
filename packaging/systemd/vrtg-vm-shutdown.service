# Reference unit that stops the VMs of the per-host agent when the host shuts
# down, reboots, halts or powers off. Development builds only: no release
# artefact ships the agent or this unit.
#
# Its stop action runs "vrtg-agent shutdown-vms", which acts only while
# systemd is stopping the system or has a shutdown, reboot, soft-reboot, halt,
# power-off or kexec job queued; stopping this unit for maintenance stops no
# VM. It never wants, requires or binds to the agent's unit, so starting it
# never starts an agent an operator stopped for maintenance (After= alone
# would only order the two units, never pull the agent in). Whether it must be
# ordered against the agent's unit is decided when the agent runs real VMs; it
# is not ordered against it today.
#
# Its stop action runs as the agent's user: vrtg-agent-setup.service, which
# it wants and starts after, creates that user first (on a host where the
# units come from a system extension merged after systemd-sysusers ran).
[Unit]
Description=VirtRigaud: stop the per-host agent's VMs at host shutdown (development builds only)
Documentation=https://github.com/projectbeskar/virtrigaud/blob/main/docs/per-host-agent-development.md
Requires=vrtg-agent-setup.service
After=local-fs.target dbus.service vrtg-agent-setup.service
# Bounded restarts: Upholds= (through multi-user.target, and the shutdown
# unit's Requires= on the setup unit) starts this unit again whenever it is
# found inactive or failed. A unit that keeps failing is started at most 5
# times in 5 minutes, then stays failed ("Start request repeated too
# quickly", result start-limit-hit) until "systemctl reset-failed" or a
# reboot.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStop=/usr/lib/virtrigaud/vrtg-agent shutdown-vms
TimeoutStopSec=330
User=virtrigaud-agent
Group=virtrigaud-agent
UMask=0077
LimitNOFILE=1024
TasksMax=32
MemoryMax=128M

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/virtrigaud-agent
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# No ProtectProc=invisible here: it hides /proc/1, and systemctl may then
# not report a shutdown in progress, so the guard could miss a real one.
PrivateIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# Filtered calls fail quietly; audit the privileged ones (systemd 247+).
SystemCallLog=@privileged
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
