# Reference unit that stops the VMs of the per-host agent when the host shuts
# down, reboots, halts or powers off. Development builds only: no release
# artefact ships the agent or this unit.
#
# Its stop action runs "vrtg-agent shutdown-vms", which acts only while
# systemd is stopping the system or has a shutdown, reboot, halt, power-off
# or kexec job queued; stopping this unit for maintenance stops no VM. It
# neither wants nor orders itself after the agent's unit, so starting it never
# starts an agent an operator stopped for maintenance.
[Unit]
Description=VirtRigaud: stop the per-host agent's VMs at host shutdown (development builds only)
Documentation=https://github.com/projectbeskar/virtrigaud/blob/main/docs/per-host-agent-development.md
After=local-fs.target dbus.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStop=/usr/libexec/virtrigaud/vrtg-agent shutdown-vms
TimeoutStopSec=330
User=virtrigaud-agent
Group=virtrigaud-agent
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/virtrigaud-agent
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
