+package controller
+
+// SPIKE 1B EXPERIMENT BUILD ONLY (hack/bench/spike1b/manager-experiment.patch).
+// Placement-lock instrumentation; see
+// docs/performance/spike-1b-control-plane-baseline.md.
+
+import (
+	"github.com/prometheus/client_golang/prometheus"
+	ctrlmetrics "sigs.k8s.io/controller-runtime/pkg/metrics"
+)
+
+var (
+	spikePlacementLockWait = prometheus.NewHistogramVec(prometheus.HistogramOpts{
+		Name:    "spike_placement_lock_wait_seconds",
+		Help:    "Wait for a Provider's assume lock (acquired or not).",
+		Buckets: prometheus.ExponentialBuckets(0.00001, 2, 24),
+	}, []string{"provider", "acquired"})
+	spikePlacementLockHold = prometheus.NewHistogramVec(prometheus.HistogramOpts{
+		Name:    "spike_placement_lock_hold_seconds",
+		Help:    "Time a placement held a Provider's assume lock (scan, Schedule, Assume).",
+		Buckets: prometheus.ExponentialBuckets(0.00001, 2, 24),
+	}, []string{"provider", "outcome"})
+)
+
+func init() {
+	ctrlmetrics.Registry.MustRegister(spikePlacementLockWait, spikePlacementLockHold)
+}
