 ) (result scheduler.Result, locked bool, err error) {
+	waitStart := time.Now()
 	unlock, locked := assumptions.LockWithin(ctx, providerKey, placementLockWait)
+	spikePlacementLockWait.WithLabelValues(providerKey, strconv.FormatBool(locked)).Observe(time.Since(waitStart).Seconds())
 	if !locked {
 		return scheduler.Result{}, false, nil
 	}
+	holdStart := time.Now()
+	defer func() {
+		outcome := "placed"
+		if err != nil {
+			outcome = "error"
+		}
+		spikePlacementLockHold.WithLabelValues(providerKey, outcome).Observe(time.Since(holdStart).Seconds())
+	}()
 	defer unlock()
 	lockCtx, cancel := lockBoundContext(ctx)
 	defer cancel()
