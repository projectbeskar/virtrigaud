# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.crt
*.cer
bin/*
Dockerfile.cross
.DS_Store

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~
*test*local.*
*.sarif

# Local development files
/tmp/virtrigaud-dev-values.yaml
/fieldTesting

# Build artifacts
dist/
*.tgz

# Generated CRDs for Helm chart (generated via make gen-helm-crds)
charts/virtrigaud/crds/*.yaml

# Development files
libvirtVM.yaml
libvirtVM-corrected.yaml
vm-example.yaml
vm-simple-example.yaml
vsphere-provider-example.yaml
libvirt-monitoring-test.yaml
*release-checklist*
*PROXMOX_*
.cursor/

# libvirt test fixtures created by main_test.go at test time
internal/providers/libvirt/_fixture_images_*/

# binaries built in place with `go build` inside a cmd directory: the exact
# name `go build` gives each one (never a glob that could match source)
/cmd/alpha-to-beta-dryrun/alpha-to-beta-dryrun
/cmd/manager/manager
/cmd/provider-cloudhypervisor/provider-cloudhypervisor
/cmd/provider-libvirt/provider-libvirt
/cmd/provider-mock/provider-mock
/cmd/provider-proxmox/provider-proxmox
/cmd/provider-vsphere/provider-vsphere
/cmd/vcts/vcts
/cmd/virtrigaud-loadgen/virtrigaud-loadgen
/cmd/vrtg/vrtg
/cmd/vrtg-agent/vrtg-agent
/cmd/vrtg-provider/vrtg-provider
